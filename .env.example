# Copy to .env on your machine (never commit).
# Integrations stay off until you set the flags below.

CS_SIGNALWIRE_ENABLED=0
CS_KILL_SWITCH=0
# A failed SMS must not place a call unless this separate flag is 1.
CS_SIGNALWIRE_SMS_FALLBACK_CALL=0

SIGNALWIRE_SPACE=
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
# SIGNALWIRE_FROM_NUMBER is the primary name. SIGNALWIRE_FROM is the same value.
SIGNALWIRE_FROM_NUMBER=
SIGNALWIRE_FROM=
# SIGNALWIRE_TO_NUMBER is the only allowed destination (verified demo handset).
# CS_DEMO_TO_NUMBER is the same value. If both are set, they must match.
# Never put an emergency number or a short code here.
SIGNALWIRE_TO_NUMBER=
CS_DEMO_TO_NUMBER=
# Public HTTPS origin for provider webhooks. Leave empty for the localhost demo.
# CS_PUBLIC_BASE=https://your-host.example
CS_PUBLIC_BASE=

# Optional local speech serves (when you run them yourself).
# CS_PARAKEET_URL=http://127.0.0.1:8091/transcribe
# CS_KOKORO_URL=http://127.0.0.1:8092/synthesize

# Optional phone TTS. Default provider stays local Kokoro unless you set elevenlabs.
# ELEVENLABS_VOICE_ID is the primary name. CS_ELEVENLABS_VOICE_ID is the same value.
# CS_TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# CS_ELEVENLABS_VOICE_ID=
# CS_ELEVENLABS_MODEL=eleven_flash_v2_5
# CS_ELEVENLABS_TIMEOUT_S=4

# Fireworks (hosts both models). Never commit the key.
FIREWORKS_API_KEY=
# Call agent: the fine-tuned Qwen3.6 35B A3B LoRA on Fireworks' serverless training
# pool (no deployment needed). Snapshot = the fw-ep2 path in
# finetune/results/serverless_run.json. Unset snapshot = keyword rules only.
CS_CALL_MODEL_BACKEND=training-pool
CS_CALL_MODEL=accounts/fireworks/models/qwen3p6-35b-a3b
CS_CALL_MODEL_SNAPSHOT=pgala3183/run-e36d3768bba4484f8004997b83d97b97/fw-ep2-99f1b28c
CS_CALL_MODEL_TIMEOUT_S=1.5
# Or, once it's promoted and deployed: CS_CALL_MODEL_BACKEND=chat with
# CS_CALL_MODEL_URL=https://api.fireworks.ai/inference/v1 and the deployed model id.
CS_CALL_MODEL_URL=
# chat backend only: set to none if the base model reasons (blank answers otherwise)
CS_CALL_MODEL_REASONING_EFFORT=
# Qwen3-VL adjudicator. Empty URL = forced/offline classification.
# ZRT_BASE_URL=https://api.fireworks.ai/inference
ZRT_BASE_URL=
ZRT_MODEL=accounts/fireworks/models/qwen3-vl-30b-a3b-instruct
# Name of the env var that holds the bearer key for ZRT_BASE_URL.
ZRT_API_KEY_ENV=FIREWORKS_API_KEY
# Live vision: unset = on whenever the three feeds and the YOLO weights are on disk;
# 0 forces it off, 1 on. cuda:0 on a GPU box, cpu otherwise.
CS_VISION_SEVILLE=
CS_VISION_DEVICE=cuda:0
CS_VISION_CONF=0.10

# Weapon-incident guardrail. Leave empty for First Witness: the check is skipped.
# WATSONX_APIKEY=
# WATSONX_PROJECT_ID=
# WATSONX_URL=

# Feed folder. Empty uses data/clips, where scripts/build_demo_from_clips.py writes them.
CS_MEDIA_ROOT=
# live = place a real call (verified handset only). Unset = the on-screen call, no dialing.
# CS_CALL_MODE=live
# History database (default data/runtime/sentinel.db)
CS_DB_PATH=
